# Copy this file to .env (same folder) and fill in your own keys:
#   cp .env.example .env
# .env is git-ignored. Never commit it or paste keys into code.
# See the README "API keys" section for where to get each one.

# Anthropic (LLM). https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Leave blank unless the setup check says your key needs a workspace.
# Better fix: create the key inside a workspace in the console.
ANTHROPIC_WORKSPACE_ID=
# The final notebook ran on claude-haiku-4-5. Changing the model
# changes every LLM cache key, so an offline replay would miss.
LLM_MODEL=claude-haiku-4-5

# NewsAPI. https://newsapi.org/register
NEWSAPI_KEY=

# FRED economic data. https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Alpha Vantage earnings data. https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# SEC EDGAR needs no key, just your name and email in the User-Agent.
SEC_USER_AGENT="Your Name your.email@sandiego.edu"

# normal = fetch when the cache is stale; offline = cache only
CACHE_MODE=normal

# Date (YYYY-MM-DD) the news and FRED tools count back from. Those dates
# are part of the cache keys, so a replay on a later day needs the date
# of the live run. Unset = today; the notebook defaults to 2026-10-18.
# Leave it commented out rather than blank: a blank value overrides the
# notebook's default.
# AS_OF_DATE=2026-10-18
